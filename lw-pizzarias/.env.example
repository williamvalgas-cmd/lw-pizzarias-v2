# Copie para as variáveis de ambiente da hospedagem (nunca suba o arquivo real para o GitHub)
ADMIN_PASSWORD=troque-por-uma-senha-longa
NODE_ENV=production
TRUST_PROXY=1
DATA_DIR=/data
# Firebase: cole o JSON da conta de serviço em BASE64 (veja o README, passo 4)
FIREBASE_SERVICE_ACCOUNT=
# Opcional: nome da coleção (padrão: pedidos)
# FIREBASE_ORDERS_COLLECTION=pedidos
