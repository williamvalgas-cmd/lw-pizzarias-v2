rules_version = '2';
// O site NUNCA acessa o Firestore direto: só o servidor (Admin SDK, que ignora estas regras).
// Por isso o acesso pelo navegador fica totalmente bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
